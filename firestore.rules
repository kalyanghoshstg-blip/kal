rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /analytics/{docId} {
      allow read: if true;
      allow write: if true;

      match /logs/{logId} {
        allow read: if true;
        allow write: if true;
      }
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
